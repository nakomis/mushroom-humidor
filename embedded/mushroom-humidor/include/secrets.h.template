// Template for secrets.h, which is git-ignored.
//
// Generate secrets.h with embedded/deployscripts/set-config.sh, which replaces each
// placeholder with values from the deployed MushroomIoTStack (IoT endpoint and SSM
// parameters). Alternatively, copy this file to secrets.h and replace each
// placeholder by hand.

#ifndef MUSHROOM_SECRETS_H
#define MUSHROOM_SECRETS_H

#include <pgmspace.h>

const char WIFI_SSID[] = "@@WIFI_SSID@@";
const char WIFI_PASSWORD[] = "@@WIFI_PASSWORD@@";

// aws iot describe-endpoint --endpoint-type iot:Data-ATS
const char AWS_IOT_ENDPOINT[] = "@@AWS_IOT_ENDPOINT@@";

// Thing name from the IoT stack, also used as the MQTT client ID
const char AWS_IOT_THING_NAME[] = "@@AWS_IOT_THING_NAME@@";

// Topic matched by the MushroomThingToDynamoDB IoT rule
const char AWS_IOT_TOPIC_TELEMETRY[] = "@@AWS_IOT_TOPIC_TELEMETRY@@";

// Amazon Root CA 1 (AmazonRootCA1.pem)
static const char AWS_CERT_CA[] PROGMEM = R"EOF(
@@AWS_CERT_CA@@
)EOF";

// Device Certificate (SSM: /Mushroom/<thing name>/certPem)
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
@@AWS_CERT_CRT@@
)KEY";

// Device Private Key (SSM: /Mushroom/<thing name>/privKey)
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
@@AWS_CERT_PRIVATE@@
)KEY";

#endif
